; Engine configuration file.
; Edit through the editor when possible.
; Format: https://docs.godotengine.org/en/stable/contributing/development/file_formats/tscn.html

config_version=5

[application]

config/name="Ruta Nocturna: 1999"
config/description="Terror psicológico y conducción de supervivencia en la Venezuela de 1999."
config/version="0.3.4"
run/main_scene="res://scenes/boot/Boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/branding/icon.svg"
config/use_custom_user_dir=true
config/custom_user_dir_name="RutaNocturna1999"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
environment/defaults/default_clear_color=Color(0.015, 0.024, 0.035, 1)
anti_aliasing/quality/msaa_3d=1
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/fallback="es_VE"

[boot_splash]

bg_color=Color(0.015, 0.024, 0.035, 1)
show_image=true
image="res://assets/branding/icon.svg"

[autoload]

EventBus="*res://src/core/event_bus.gd"
HardwareProfiler="*res://src/core/hardware_profiler.gd"
SettingsManager="*res://src/core/settings_manager.gd"
LocalizationManager="*res://src/core/localization_manager.gd"
GameState="*res://src/core/game_state.gd"
SaveManager="*res://src/core/save_manager.gd"
AudioDirector="*res://src/core/audio_director.gd"
WeatherManager="*res://src/core/weather_manager.gd"
UpdateChecker="*res://src/core/update_checker.gd"
CrashReporter="*res://src/core/crash_reporter.gd"
SceneRouter="*res://src/core/scene_router.gd"

