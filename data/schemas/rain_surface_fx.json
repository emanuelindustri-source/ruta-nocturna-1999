  "wetness": {
    "equation": {
      "rain_mm_h": "rain_intensity * precipitation.rain_intensity_to_mm_h",
      "input_mm_s": "rain_mm_h / 3600.0 * class.rain_capture * panel.exposure",
      "drainage_mm_s": "class.drainage_rate_per_s * max(0.0, film_mm - class.retention_mm)",
      "evaporation_mm_s": "class.evaporation_rate_per_s * film_mm * pow(max(0.05, 1.0 - humidity), precipitation.humidity_drying_exponent) * (1.0 + min(wind_mps, precipitation.max_wind_mps) * class.wind_drying_gain) * (1.0 + max(0.0, temperature_c - wetness.drying_temperature_reference_c) * class.temperature_drying_gain)",
      "infiltration_mm_s": "class.infiltration_rate_per_s * film_mm",
      "film_step_mm": "clamp(film_mm + (input_mm_s - drainage_mm_s - evaporation_mm_s - infiltration_mm_s) * dt, 0.0, class.max_film_mm)",
      "wetness": "film_mm / class.max_film_mm"
    },
    "state_thresholds": {
      "dry": 0.05,
      "damp": 0.25,
      "wet": 0.55,
      "soaked": 0.85
    },
    "state_hysteresis": 0.03,
    "drying_temperature_reference_c": 10.0,
    "pc_update_hz": 60,
    "mobile_update_hz": 30,
    "note": "El runtime aplica exactamente estas ecuaciones con dt acotado a precipitation.max_step_s. La clase y la exposicion salen del panel; la lluvia, humedad, viento y temperatura las inyecta WeatherManager en F4.4."
  },
  "droplets": {
    "instance_stride": 6,
    "instance_layout": ["x_mm", "y_mm", "radius_mm", "velocity_x_mps", "velocity_y_mps", "state"],
    "profiles": [
      {
        "id": "glass",
        "max_droplets": 1536,
        "area_m2": 0.59,
        "nucleation_per_m2_s": 90.0,
        "nucleation_wetness": 0.08,
