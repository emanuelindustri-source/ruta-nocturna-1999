  "puddles": {
    "equation": {
      "rain_mm_h": "rain_intensity * precipitation.rain_intensity_to_mm_h",
      "direct_inflow_mm_s": "rain_mm_h / 3600.0 * archetype.rain_capture * archetype.exposure",
      "drying_factor": "pow(max(0.05, 1.0 - humidity), precipitation.humidity_drying_exponent) * (1.0 + min(wind_mps, precipitation.max_wind_mps) * drying.wind_gain_per_mps) * (1.0 + max(0.0, temperature_c - wetness.drying_temperature_reference_c) * drying.temperature_gain_per_c)",
      "runoff_inflow_mm_s": "runoff_mm_s * archetype.upstream_runoff_gain",
      "outflow_mm_s": "(archetype.drainage_rate_per_s + archetype.infiltration_rate_per_s + archetype.evaporation_rate_per_s * drying_factor) * depth_mm",
      "depth_step_mm": "clamp(depth_mm + (direct_inflow_mm_s + runoff_inflow_mm_s - outflow_mm_s) * dt, 0.0, archetype.capacity_mm)"
    },
