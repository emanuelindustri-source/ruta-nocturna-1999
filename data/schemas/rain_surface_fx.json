        "growth_mm_per_s": 0.55,
        "critical_radius_mm": 1.6,
        "slide_wetness_gain": 0.55,
        "terminal_speed_mps": 0.42,
        "accel_mps2": 0.9,
        "evaporation_shrink_mm_per_s": 0.08,
        "wind_drift_per_mps": 0.012,
        "bounds_m": [1.23, 0.483],
        "trail_width_mm": 0.35,
        "seed": 1999,
        "source_status": "design_value_pending_f34_lookdev",
        "source_note": "Gotas de vidrio: nucleacion temprana, crecimiento rapido y desliz a partir de 1,6 mm; el GLSL de F3.4 dibuja la forma y el estela."
      },
      {
        "id": "paint",
        "max_droplets": 2560,
        "area_m2": 2.1,
        "nucleation_per_m2_s": 45.0,
        "nucleation_wetness": 0.28,
        "growth_wetness": 0.5,
        "initial_radius_mm": 0.16,
        "min_radius_mm": 0.07,
        "max_radius_mm": 3.6,
        "growth_mm_per_s": 0.35,
        "critical_radius_mm": 2.2,
        "slide_wetness_gain": 0.5,
        "terminal_speed_mps": 0.3,
        "accel_mps2": 0.7,
        "evaporation_shrink_mm_per_s": 0.05,
        "wind_drift_per_mps": 0.02,
        "bounds_m": [1.56, 1.35],
        "trail_width_mm": 0.45,
        "seed": 2000,
        "source_status": "design_value_pending_f34_lookdev",
        "source_note": "Gotas sobre pintura: mas tardias, mas grandes y mas lentas que en vidrio; el viento las desplaza hacia atras."
      }
    ],
    "equations": {
      "spawn_rate_per_s": "profile.nucleation_per_m2_s * profile.area_m2 * rain_intensity * clamp((wetness - profile.nucleation_wetness) / max(0.001, 1.0 - profile.nucleation_wetness), 0.0, 1.0)",
      "growth_mm_s": "profile.growth_mm_per_s * clamp((wetness - profile.growth_wetness) / max(0.001, 1.0 - profile.growth_wetness), 0.0, 1.0)",
      "critical_radius_mm": "profile.critical_radius_mm * (1.0 - profile.slide_wetness_gain * clamp(wetness, 0.0, 1.0))",
      "sliding_speed_m_s": "move_toward(velocity_m_s, profile.terminal_speed_mps, profile.accel_mps2 * dt)",
      "evaporation_mm_s": "profile.evaporation_shrink_mm_per_s * clamp(1.0 - wetness / max(0.001, profile.nucleation_wetness), 0.0, 1.0)",
      "wind_drift": "normalize(flow_dir + lateral_axis * wind_mps * profile.wind_drift_per_mps)"
    },
    "coalescence_note": "La fusion visual de gotas vecinas queda para el shader de F3.4; el modelo de F3.3 mantiene gotas independientes para que el coste CPU sea medible y determinista.",
    "runoff_note": "Cada gota que sale del rectangulo de la superficie suma su volumen aproximado al contador de escurrido; F5.1 podra usar ese dato para charcos y vadeo."
  },
