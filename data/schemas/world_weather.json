  "transition": {
    "rate_per_s": 0.55,
    "wetness_rate_per_s": 0.08,
    "min_visible_change": 0.001,
    "hysteresis": 0.02,
    "auto_advance": true,
    "auto_advance_s": [45.0, 120.0],
    "region_change_immediate": true,
    "region_change_rate_per_s": 1.2,
    "note": "Interpolación exponencial por delta; la humedad y la lluvia nunca cambian de golpe salvo en QA. La región usa una transición más rápida para evitar un clima incoherente en el límite del bioma."
  },
