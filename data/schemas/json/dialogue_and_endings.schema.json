{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruta-nocturna:schemas:dialogue_and_endings:1",
  "title": "Contrato de diálogos, confianza y finales",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "content_status", "entry_node", "meters", "passengers", "nodes", "ending_evaluator", "endings"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_status": {"type": "string"},
    "design_rule": {"type": "string"},
    "entry_node": {"type": "string"},
    "meters": {"type": "object"},
    "passengers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name_key", "role_key", "trust_start", "trust_min", "trust_max", "join_regions", "arc_key"],
        "properties": {
          "id": {"type": "string", "pattern": "^passenger\\.[a-z0-9_]+$"},
          "name_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "role_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "trust_start": {"type": "integer", "minimum": -100, "maximum": 100},
          "trust_min": {"type": "integer", "minimum": -100},
          "trust_max": {"type": "integer", "maximum": 100},
          "join_regions": {"type": "array", "items": {"type": "string"}},
          "arc_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/dialogue_node"}
    },
    "ending_evaluator": {
      "type": "object",
      "required": ["order", "guarantee_one", "fallback_ending"],
      "properties": {
        "order": {"type": "string"},
        "guarantee_one": {"type": "boolean"},
        "fallback_ending": {"type": "string"}
      }
    },
    "endings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title_key", "description_key", "priority", "conditions", "scene_key"],
        "properties": {
          "id": {"type": "string", "pattern": "^end_[a-z0-9_]+$"},
          "title_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "description_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "priority": {"type": "integer"},
          "conditions": {"type": "object"},
          "scene_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    }
  },
  "$defs": {
    "conditions": {
      "type": "object",
      "properties": {
        "all": {"type": "array", "items": {"type": "object"}},
        "any": {"type": "array", "items": {"type": "object"}},
        "not": {"type": "object"}
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["op", "target", "value"],
        "properties": {
          "op": {"type": "string"},
          "target": {"type": "string"},
          "value": {}
        }
      }
    },
    "choice": {
      "type": "object",
      "required": ["id", "text_key", "conditions", "effects", "next"],
      "properties": {
        "id": {"type": "string"},
        "text_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "conditions": {"$ref": "#/$defs/conditions"},
        "effects": {"$ref": "#/$defs/effects"},
        "next": {"type": ["string", "null"]}
      }
    },
    "dialogue_node": {
      "type": "object",
      "required": ["id", "type", "speaker_id", "text_key", "conditions", "effects", "next", "choices"],
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["line", "choice", "condition", "end"]},
        "speaker_id": {"type": "string"},
        "text_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "voice_key": {"type": "string"},
        "conditions": {"$ref": "#/$defs/conditions"},
        "effects": {"$ref": "#/$defs/effects"},
        "next": {"type": ["string", "null"]},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/choice"}}
      }
    }
  }
}
