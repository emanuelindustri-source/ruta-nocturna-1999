{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ruta-nocturna-1999.invalid/schemas/world_route_network.schema.json",
  "title": "Ruta Nocturna 1999 — red de rutas generada",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_version",
    "contract_id",
    "world_id",
    "coordinate_system",
    "elevation_unit",
    "source",
    "projection",
    "regions",
    "nodes",
    "edges",
    "routes",
    "stats",
    "attribution"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "artifact_version": {"const": 1},
    "contract_id": {"const": "world.routes"},
    "world_id": {"const": "venezuela.1999"},
    "coordinate_system": {"const": "WGS84"},
    "elevation_unit": {"const": "m"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "osm_base_timestamp",
        "extract_bbox",
        "queries",
        "way_count",
        "raw_node_count",
        "license",
        "copyright"
      ],
      "properties": {
        "osm_base_timestamp": {"type": "string", "minLength": 10},
        "extract_bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number"}
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/query_source"}
        },
        "way_count": {"type": "integer", "minimum": 1},
        "raw_node_count": {"type": "integer", "minimum": 1},
        "license": {"const": "ODbL 1.0"},
        "copyright": {"type": "string", "minLength": 3}
      }
    },
    "projection": {"$ref": "#/$defs/projection"},
    "regions": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/region_summary"}
    },
    "nodes": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "minItems": 10,
      "items": {"$ref": "#/$defs/edge"}
    },
    "routes": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/route"}
    },
    "stats": {"$ref": "#/$defs/stats"},
    "attribution": {"$ref": "#/$defs/attribution"}
  },
  "$defs": {
    "geo": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"type": "number"},
      "prefixItems": [
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180}
      ]
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "origin",
        "meters_per_degree_lat",
        "meters_per_degree_lon",
        "world_scale",
        "vertical_scale"
      ],
      "properties": {
        "mode": {"const": "equirectangular_local"},
        "origin": {"$ref": "#/$defs/geo"},
        "meters_per_degree_lat": {"type": "number", "exclusiveMinimum": 0},
        "meters_per_degree_lon": {"type": "number", "exclusiveMinimum": 0},
        "world_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "vertical_scale": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "query_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "highway_regex",
        "osm_base_timestamp",
        "sha256",
        "bytes",
        "way_count"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "highway_regex": {"type": "string", "minLength": 3},
        "osm_base_timestamp": {"type": "string", "minLength": 10},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "bytes": {"type": "integer", "minimum": 1},
        "way_count": {"type": "integer", "minimum": 0}
      }
    },
    "region_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "center",
        "hub_node",
        "elevation_m",
        "elevation_expected_m",
        "snap_offset_m",
        "within_expected",
        "terrain_character"
      ],
      "properties": {
        "id": {"enum": ["carabobo", "falcon", "merida", "llanos", "amazonas", "delta"]},
        "center": {"$ref": "#/$defs/geo"},
        "hub_node": {"type": "string", "pattern": "^hub_"},
        "elevation_m": {"type": "number", "minimum": -50, "maximum": 5000},
        "elevation_expected_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "snap_offset_m": {"type": "number", "minimum": 0},
        "within_expected": {"type": "boolean"},
        "terrain_character": {"enum": ["coast", "mountains", "plains", "rainforest", "delta"]}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "region",
        "geo",
        "elevation_m",
        "game_m",
        "degree"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^(hub_[a-z_]+|node_[a-f0-9]{8})$"},
        "kind": {"enum": ["hub", "junction", "waypoint"]},
        "region": {
          "anyOf": [
            {"enum": ["carabobo", "falcon", "merida", "llanos", "amazonas", "delta"]},
            {"type": "null"}
          ]
        },
        "geo": {"$ref": "#/$defs/geo"},
        "elevation_m": {"type": "number", "minimum": -50, "maximum": 5000},
        "game_m": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {"type": "number"}
        },
        "degree": {"type": "integer", "minimum": 1}
      }
    },
    "shape_point": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "number"},
      "prefixItems": [
        {"type": "number", "minimum": -90, "maximum": 90},
        {"type": "number", "minimum": -180, "maximum": 180},
        {"type": "number", "minimum": -100, "maximum": 6000}
      ]
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "road_class",
        "ref",
        "distance_m",
        "travel_time_s",
        "cost",
        "ascent_m",
        "descent_m",
        "min_elevation_m",
        "max_elevation_m",
        "max_grade_pct",
        "regions",
        "shape"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^edge_[a-f0-9]{8}$"},
        "from": {"type": "string", "pattern": "^(hub_[a-z_]+|node_[a-f0-9]{8})$"},
        "to": {"type": "string", "pattern": "^(hub_[a-z_]+|node_[a-f0-9]{8})$"},
        "road_class": {"enum": ["motorway", "trunk", "primary", "secondary"]},
        "ref": {"anyOf": [{"type": "string", "maxLength": 40}, {"type": "null"}]},
        "distance_m": {"type": "number", "exclusiveMinimum": 0},
        "travel_time_s": {"type": "number", "exclusiveMinimum": 0},
        "cost": {"type": "number", "exclusiveMinimum": 0},
        "ascent_m": {"type": "number", "minimum": 0},
        "descent_m": {"type": "number", "minimum": 0},
        "min_elevation_m": {"type": "number", "minimum": -50},
        "max_elevation_m": {"type": "number", "minimum": -50},
        "max_grade_pct": {"type": "number", "minimum": 0, "maximum": 100},
        "regions": {
          "type": "array",
          "items": {"enum": ["carabobo", "falcon", "merida", "llanos", "amazonas", "delta"]}
        },
        "shape": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/shape_point"}
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "alternative_index",
        "distance_m",
        "travel_time_s",
        "ascent_m",
        "descent_m",
        "min_elevation_m",
        "max_elevation_m",
        "node_ids",
        "edge_ids",
        "overlap_ratio_vs_main",
        "detour_ratio_vs_main",
        "region_sequence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^route\\.[a-z0-9_]+$"},
        "from": {"type": "string", "pattern": "^hub_"},
        "to": {"type": "string", "pattern": "^hub_"},
        "kind": {"enum": ["main", "alternative"]},
        "alternative_index": {"type": "integer", "minimum": 0},
        "distance_m": {"type": "number", "exclusiveMinimum": 0},
        "travel_time_s": {"type": "number", "exclusiveMinimum": 0},
        "ascent_m": {"type": "number", "minimum": 0},
        "descent_m": {"type": "number", "minimum": 0},
        "min_elevation_m": {"type": "number", "minimum": -50},
        "max_elevation_m": {"type": "number", "minimum": -50},
        "node_ids": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "pattern": "^(hub_[a-z_]+|node_[a-f0-9]{8})$"}
        },
        "edge_ids": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^edge_[a-f0-9]{8}$"}
        },
        "overlap_ratio_vs_main": {"type": "number", "minimum": 0, "maximum": 1},
        "detour_ratio_vs_main": {"type": "number", "minimum": 0},
        "region_sequence": {
          "type": "array",
          "items": {"enum": ["carabobo", "falcon", "merida", "llanos", "amazonas", "delta"]}
        }
      }
    },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node_count",
        "edge_count",
        "route_count",
        "main_route_count",
        "alternative_count",
        "hub_count",
        "total_main_distance_km",
        "total_network_distance_km",
        "min_elevation_m",
        "max_elevation_m"
      ],
      "properties": {
        "node_count": {"type": "integer", "minimum": 1},
        "edge_count": {"type": "integer", "minimum": 1},
        "route_count": {"type": "integer", "minimum": 1},
        "main_route_count": {"type": "integer", "minimum": 1},
        "alternative_count": {"type": "integer", "minimum": 0},
        "hub_count": {"const": 6},
        "total_main_distance_km": {"type": "number", "exclusiveMinimum": 0},
        "total_network_distance_km": {"type": "number", "exclusiveMinimum": 0},
        "min_elevation_m": {"type": "number", "minimum": -50},
        "max_elevation_m": {"type": "number", "minimum": -50}
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "copyright",
        "license",
        "license_url",
        "copyright_url",
        "notice_es",
        "notice_en",
        "in_game_key",
        "dem_attribution",
        "share_alike"
      ],
      "properties": {
        "dataset": {"const": "OpenStreetMap"},
        "copyright": {"type": "string", "minLength": 3},
        "license": {"const": "ODbL 1.0"},
        "license_url": {"type": "string", "pattern": "^https://"},
        "copyright_url": {"type": "string", "pattern": "^https://"},
        "notice_es": {"type": "string", "minLength": 20},
        "notice_en": {"type": "string", "minLength": 20},
        "in_game_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "dem_attribution": {"type": "string", "minLength": 20},
        "share_alike": {"const": true}
      }
    }
  }
}
