{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ruta-nocturna:schemas:inventory_tools:1",
  "title": "Contrato de herramientas y suministros",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "currency", "items"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "content_status": {"type": "string"},
    "currency": {"const": "VES_1999"},
    "balance_note": {"type": "string"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "name_key", "description_key", "category", "is_tool", "unit_cost_bs", "stackable", "max_stack", "tags"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_.]+$"},
          "name_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "description_key": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "category": {"type": "string", "minLength": 2},
          "is_tool": {"type": "boolean"},
          "unit_cost_bs": {"type": "integer", "minimum": 0},
          "stackable": {"type": "boolean"},
          "max_stack": {"type": "integer", "minimum": 1},
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    }
  }
}
