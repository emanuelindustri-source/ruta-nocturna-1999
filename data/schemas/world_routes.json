    "raw_cache_dir": "build/cache/osm"
  },
  "dem": {
    "source": "Mapzen Terrain Tiles (Terrarium)",
    "method": "Muestreo bilineal de teselas Terrarium en tiempo de build",
    "tile_url": "https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png",
    "zoom": 10,
    "sample_interval_m": 1000,
    "smoothing": "media móvil de 3 puntos antes de calcular ascenso, descenso y pendiente",
    "vertical_datum": "metros sobre el nivel del mar según Terrarium (SRTM/GMTED2010/ETOPO1)",
    "attribution": "Teselas de elevación de Mapzen/Tilezen; SRTM y GMTED2010 cortesía del U.S. Geological Survey; ETOPO1 cortesía de NOAA.",
    "attribution_url": "https://github.com/tilezen/joerd/blob/master/docs/attribution.md",
    "cache_dir": "build/cache/dem",
    "note": "Solo se usa en el pipeline de build; el juego no consulta DEM ni teselas en runtime. F4.2 consume la elevación por nodo y arista para el terreno."
  },
